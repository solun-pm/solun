{
  "name": "@solun/api",
  "version": "1.3.18",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "pnpm --filter @solun/shared build",
    "dev": "tsx watch src/index.ts",
    "prestart": "pnpm --filter @solun/shared build",
    "prebuild": "prisma generate --schema=prisma/schema.prisma",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "cleanup": "tsx src/run-file-cleanup.ts",
    "lint": "echo \"No lint configured\"",
    "pretypecheck": "prisma generate --schema=prisma/schema.prisma",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1156.0",
    "@aws-sdk/s3-request-presigner": "^3.1156.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@solun/shared": "workspace:*",
    "busboy": "^1.6.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "nanoid": "^6.0.2",
    "node-cron": "^4.6.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/busboy": "^1.5.5",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "prisma": "^7.10.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
